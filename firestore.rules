rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Profiles ---
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'username', 'displayName']) &&
        data.keys().hasOnly(['uid', 'username', 'displayName', 'bio', 'academicTitle', 'avatarUrl', 'avatarEmoji', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid == request.auth.uid &&
        data.username is string && data.username.size() >= 2 && data.username.size() <= 50 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 300)) &&
        (!('academicTitle' in data) || (data.academicTitle is string && data.academicTitle.size() <= 100)) &&
        (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 65000)) &&
        (!('avatarEmoji' in data) || (data.avatarEmoji is string && data.avatarEmoji.size() <= 10));
    }

    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if isSignedIn();

      allow create: if isValidId(userId) &&
        isSignedIn() &&
        userId == request.auth.uid &&
        isValidUserProfile(incoming()) &&
        incoming().uid == request.auth.uid;

      allow update: if isValidId(userId) &&
        isSignedIn() &&
        userId == request.auth.uid &&
        resource.data.uid == request.auth.uid &&
        isValidUserProfile(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['username', 'displayName', 'bio', 'academicTitle', 'avatarUrl', 'avatarEmoji', 'updatedAt']);

      allow delete: if false;
    }

    // --- Graphs ---
    function isValidGraph(data) {
      return data.keys().hasAll(['title', 'authorId', 'shareCode', 'isPublic', 'expressionsJson', 'viewportJson']) &&
        data.keys().hasOnly(['title', 'description', 'authorId', 'authorName', 'shareCode', 'isPublic', 'expressionsJson', 'viewportJson', 'gridMode', 'themeId', 'createdAt', 'updatedAt']) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
        data.authorId is string && data.authorId == request.auth.uid &&
        (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 100)) &&
        data.shareCode is string && data.shareCode.size() <= 64 &&
        data.isPublic is bool &&
        data.expressionsJson is string && data.expressionsJson.size() <= 25000 &&
        data.viewportJson is string && data.viewportJson.size() <= 1000 &&
        (!('gridMode' in data) || (data.gridMode is string && data.gridMode.size() <= 20)) &&
        (!('themeId' in data) || (data.themeId is string && data.themeId.size() <= 30));
    }

    match /graphs/{graphId} {
      allow get: if isValidId(graphId) && (
        resource.data.isPublic == true ||
        (isSignedIn() && resource.data.authorId == request.auth.uid)
      );

      allow list: if (
        resource.data.isPublic == true ||
        (isSignedIn() && resource.data.authorId == request.auth.uid)
      );

      allow create: if isValidId(graphId) &&
        isSignedIn() &&
        isValidGraph(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(graphId) &&
        isSignedIn() &&
        resource.data.authorId == request.auth.uid &&
        isValidGraph(incoming()) &&
        incoming().authorId == resource.data.authorId &&
        incoming().createdAt == resource.data.createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'authorName', 'isPublic', 'expressionsJson', 'viewportJson', 'gridMode', 'themeId', 'updatedAt']);

      allow delete: if isValidId(graphId) &&
        isSignedIn() &&
        resource.data.authorId == request.auth.uid;
    }

    // --- Research Posts & Vlog Publications ---
    function isValidResearchPost(data) {
      return data.keys().hasAll(['title', 'category', 'authorId', 'latexStatement', 'body', 'isPublic']) &&
        data.keys().hasOnly(['title', 'category', 'authorId', 'authorName', 'authorTitle', 'authorAvatarEmoji', 'latexStatement', 'body', 'attachedExpressionsJson', 'mediaAttachmentsJson', 'vlogVideoUrl', 'vlogStepsJson', 'tags', 'endorsementsCount', 'commentsCount', 'isPublic', 'createdAt', 'updatedAt']) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
        data.category is string && data.category.size() <= 30 &&
        data.authorId is string && data.authorId == request.auth.uid &&
        (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 100)) &&
        (!('authorTitle' in data) || (data.authorTitle is string && data.authorTitle.size() <= 100)) &&
        (!('authorAvatarEmoji' in data) || (data.authorAvatarEmoji is string && data.authorAvatarEmoji.size() <= 10)) &&
        data.latexStatement is string && data.latexStatement.size() <= 2000 &&
        data.body is string && data.body.size() <= 10000 &&
        (!('attachedExpressionsJson' in data) || (data.attachedExpressionsJson is string && data.attachedExpressionsJson.size() <= 25000)) &&
        (!('mediaAttachmentsJson' in data) || (data.mediaAttachmentsJson is string && data.mediaAttachmentsJson.size() <= 65000)) &&
        (!('vlogVideoUrl' in data) || (data.vlogVideoUrl is string && data.vlogVideoUrl.size() <= 500)) &&
        (!('vlogStepsJson' in data) || (data.vlogStepsJson is string && data.vlogStepsJson.size() <= 25000)) &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 10)) &&
        (!('endorsementsCount' in data) || (data.endorsementsCount is number && data.endorsementsCount >= 0)) &&
        (!('commentsCount' in data) || (data.commentsCount is number && data.commentsCount >= 0)) &&
        data.isPublic is bool;
    }

    match /research_posts/{postId} {
      allow get: if isValidId(postId) && (
        resource.data.isPublic == true ||
        (isSignedIn() && resource.data.authorId == request.auth.uid)
      );

      allow list: if (
        resource.data.isPublic == true ||
        (isSignedIn() && resource.data.authorId == request.auth.uid)
      );

      allow create: if isValidId(postId) &&
        isSignedIn() &&
        isValidResearchPost(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(postId) &&
        isSignedIn() &&
        (
          (resource.data.authorId == request.auth.uid &&
           isValidResearchPost(incoming()) &&
           incoming().authorId == resource.data.authorId &&
           incoming().createdAt == resource.data.createdAt &&
           incoming().updatedAt == request.time &&
           incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'authorName', 'authorTitle', 'authorAvatarEmoji', 'latexStatement', 'body', 'attachedExpressionsJson', 'mediaAttachmentsJson', 'vlogVideoUrl', 'vlogStepsJson', 'tags', 'isPublic', 'endorsementsCount', 'commentsCount', 'updatedAt'])) ||
          (incoming().diff(existing()).affectedKeys().hasOnly(['endorsementsCount', 'updatedAt']) &&
           incoming().endorsementsCount is number &&
           incoming().updatedAt == request.time) ||
          (incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount', 'updatedAt']) &&
           incoming().commentsCount is number &&
           incoming().updatedAt == request.time)
        );

      allow delete: if isValidId(postId) &&
        isSignedIn() &&
        resource.data.authorId == request.auth.uid;

      // --- Comments on Research Posts ---
      function isValidComment(data) {
        return data.keys().hasAll(['postId', 'authorId', 'authorName', 'content']) &&
          data.keys().hasOnly(['postId', 'authorId', 'authorName', 'authorTitle', 'authorAvatarEmoji', 'content', 'createdAt', 'updatedAt']) &&
          data.postId is string && data.postId == postId &&
          data.authorId is string && data.authorId == request.auth.uid &&
          data.authorName is string && data.authorName.size() <= 100 &&
          (!('authorTitle' in data) || (data.authorTitle is string && data.authorTitle.size() <= 100)) &&
          (!('authorAvatarEmoji' in data) || (data.authorAvatarEmoji is string && data.authorAvatarEmoji.size() <= 10)) &&
          data.content is string && data.content.size() > 0 && data.content.size() <= 2000;
      }

      match /comments/{commentId} {
        allow get: if isValidId(commentId);
        allow list: if true;
        allow create: if isValidId(commentId) &&
          isSignedIn() &&
          isValidComment(incoming()) &&
          incoming().authorId == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(commentId) &&
          isSignedIn() &&
          resource.data.authorId == request.auth.uid &&
          isValidComment(incoming()) &&
          incoming().authorId == request.auth.uid &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['content', 'updatedAt']);
        allow delete: if isValidId(commentId) &&
          isSignedIn() &&
          resource.data.authorId == request.auth.uid;
      }
    }

    // --- Friendships ---
    function isValidFriendship(data) {
      return data.keys().hasAll(['user1Id', 'user2Id', 'status', 'initiatedBy']) &&
        data.keys().hasOnly(['user1Id', 'user2Id', 'user1Name', 'user2Name', 'user1Avatar', 'user2Avatar', 'status', 'initiatedBy', 'createdAt', 'updatedAt']) &&
        data.user1Id is string && data.user1Id.size() <= 128 &&
        data.user2Id is string && data.user2Id.size() <= 128 &&
        data.status is string && (data.status == 'pending' || data.status == 'accepted' || data.status == 'declined') &&
        data.initiatedBy is string && data.initiatedBy == request.auth.uid &&
        (!('user1Name' in data) || (data.user1Name is string && data.user1Name.size() <= 100)) &&
        (!('user2Name' in data) || (data.user2Name is string && data.user2Name.size() <= 100)) &&
        (!('user1Avatar' in data) || (data.user1Avatar is string && data.user1Avatar.size() <= 10)) &&
        (!('user2Avatar' in data) || (data.user2Avatar is string && data.user2Avatar.size() <= 10));
    }

    match /friendships/{friendshipId} {
      allow get: if isValidId(friendshipId) && isSignedIn() && (
        resource.data.user1Id == request.auth.uid ||
        resource.data.user2Id == request.auth.uid
      );
      allow list: if isSignedIn();
      allow create: if isValidId(friendshipId) &&
        isSignedIn() &&
        isValidFriendship(incoming()) &&
        (incoming().user1Id == request.auth.uid || incoming().user2Id == request.auth.uid) &&
        incoming().initiatedBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(friendshipId) &&
        isSignedIn() &&
        (resource.data.user1Id == request.auth.uid || resource.data.user2Id == request.auth.uid) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        incoming().updatedAt == request.time &&
        (incoming().status == 'accepted' || incoming().status == 'declined');
      allow delete: if isValidId(friendshipId) &&
        isSignedIn() &&
        (resource.data.user1Id == request.auth.uid || resource.data.user2Id == request.auth.uid);
    }

    // --- Direct Peer-to-Peer Sessions (between Friends) ---
    function isValidDirectP2PSession(data) {
      return data.keys().hasAll(['sessionId', 'status']) &&
        data.keys().hasOnly(['sessionId', 'participants', 'activeHost', 'hostOffer', 'guestAnswer', 'graphSyncJson', 'chatMessagesJson', 'status', 'createdAt', 'updatedAt']) &&
        data.sessionId is string && data.sessionId.size() <= 128 &&
        data.status is string && data.status.size() <= 20 &&
        (!('participants' in data) || (data.participants is list && data.participants.size() <= 4)) &&
        (!('activeHost' in data) || (data.activeHost is string && data.activeHost.size() <= 128)) &&
        (!('hostOffer' in data) || (data.hostOffer is string && data.hostOffer.size() <= 65000)) &&
        (!('guestAnswer' in data) || (data.guestAnswer is string && data.guestAnswer.size() <= 65000)) &&
        (!('graphSyncJson' in data) || (data.graphSyncJson is string && data.graphSyncJson.size() <= 100000)) &&
        (!('chatMessagesJson' in data) || (data.chatMessagesJson is string && data.chatMessagesJson.size() <= 100000));
    }

    match /direct_p2p/{sessionId} {
      allow get: if isValidId(sessionId) && isSignedIn() && (
        !('participants' in resource.data) ||
        request.auth.uid in resource.data.participants
      );
      allow list: if isSignedIn();
      allow create: if isValidId(sessionId) &&
        isSignedIn() &&
        isValidDirectP2PSession(incoming()) &&
        request.auth.uid in incoming().participants;
      allow update: if isValidId(sessionId) &&
        isSignedIn() &&
        isValidDirectP2PSession(incoming()) &&
        (
          !('participants' in resource.data) ||
          request.auth.uid in resource.data.participants
        );
      allow delete: if isValidId(sessionId) &&
        isSignedIn() &&
        request.auth.uid in resource.data.participants;
    }

    // --- Legacy P2P Rooms ---
    function isValidP2PRoom(data) {
      return data.keys().hasAll(['roomCode', 'status']) &&
        data.keys().hasOnly(['roomCode', 'status', 'hostOffer', 'guestAnswer', 'graphSyncJson', 'chatMessagesJson', 'createdAt', 'updatedAt']) &&
        data.roomCode is string && data.roomCode.size() <= 32 &&
        data.status is string && data.status.size() <= 20 &&
        (!('hostOffer' in data) || (data.hostOffer is string && data.hostOffer.size() <= 65000)) &&
        (!('guestAnswer' in data) || (data.guestAnswer is string && data.guestAnswer.size() <= 65000)) &&
        (!('graphSyncJson' in data) || (data.graphSyncJson is string && data.graphSyncJson.size() <= 100000)) &&
        (!('chatMessagesJson' in data) || (data.chatMessagesJson is string && data.chatMessagesJson.size() <= 100000));
    }

    match /p2p_rooms/{roomId} {
      allow get: if isValidId(roomId);
      allow list: if false;
      allow create: if isValidId(roomId) && isValidP2PRoom(incoming());
      allow update: if isValidId(roomId) && isValidP2PRoom(incoming());
      allow delete: if isValidId(roomId);
    }
  }
}
