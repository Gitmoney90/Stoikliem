rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'username', 'displayName']) &&
        data.keys().hasOnly(['uid', 'username', 'displayName', 'bio', 'academicTitle', 'avatarUrl', 'avatarEmoji', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid == request.auth.uid &&
        data.username is string && data.username.size() >= 2 && data.username.size() <= 50 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 300)) &&
        (!('academicTitle' in data) || (data.academicTitle is string && data.academicTitle.size() <= 100)) &&
        (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 1000)) &&
        (!('avatarEmoji' in data) || (data.avatarEmoji is string && data.avatarEmoji.size() <= 10));
    }

    match /users/{userId} {
      // Anyone can read profiles to see usernames on submissions and public author cards
      allow get: if isValidId(userId);
      allow list: if isSignedIn();

      // Only the authenticated user can create or modify their own profile
      allow create: if isValidId(userId) &&
        isSignedIn() &&
        userId == request.auth.uid &&
        isValidUserProfile(incoming()) &&
        incoming().uid == request.auth.uid;

      allow update: if isValidId(userId) &&
        isSignedIn() &&
        userId == request.auth.uid &&
        resource.data.uid == request.auth.uid &&
        isValidUserProfile(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['username', 'displayName', 'bio', 'academicTitle', 'avatarUrl', 'avatarEmoji', 'updatedAt']);

      allow delete: if false;
    }

    function isValidGraph(data) {
      return data.keys().hasAll(['title', 'authorId', 'shareCode', 'isPublic', 'expressionsJson', 'viewportJson']) &&
        data.keys().hasOnly(['title', 'description', 'authorId', 'authorName', 'shareCode', 'isPublic', 'expressionsJson', 'viewportJson', 'gridMode', 'themeId', 'createdAt', 'updatedAt']) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
        data.authorId is string && data.authorId == request.auth.uid &&
        (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 100)) &&
        data.shareCode is string && data.shareCode.size() <= 64 &&
        data.isPublic is bool &&
        data.expressionsJson is string && data.expressionsJson.size() <= 25000 &&
        data.viewportJson is string && data.viewportJson.size() <= 1000 &&
        (!('gridMode' in data) || (data.gridMode is string && data.gridMode.size() <= 20)) &&
        (!('themeId' in data) || (data.themeId is string && data.themeId.size() <= 30));
    }

    match /graphs/{graphId} {
      allow get: if isValidId(graphId) && (
        resource.data.isPublic == true ||
        (isSignedIn() && resource.data.authorId == request.auth.uid)
      );

      allow list: if (
        resource.data.isPublic == true ||
        (isSignedIn() && resource.data.authorId == request.auth.uid)
      );

      allow create: if isValidId(graphId) &&
        isSignedIn() &&
        isValidGraph(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(graphId) &&
        isSignedIn() &&
        resource.data.authorId == request.auth.uid &&
        isValidGraph(incoming()) &&
        incoming().authorId == resource.data.authorId &&
        incoming().createdAt == resource.data.createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'authorName', 'isPublic', 'expressionsJson', 'viewportJson', 'gridMode', 'themeId', 'updatedAt']);

      allow delete: if isValidId(graphId) &&
        isSignedIn() &&
        resource.data.authorId == request.auth.uid;
    }
  }
}
