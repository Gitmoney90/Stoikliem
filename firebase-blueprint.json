{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with customizable username, bio, academic title, and avatar styling",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128
        },
        "username": {
          "type": "string",
          "maxLength": 50
        },
        "displayName": {
          "type": "string",
          "maxLength": 100
        },
        "bio": {
          "type": "string",
          "maxLength": 300
        },
        "academicTitle": {
          "type": "string",
          "maxLength": 100
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 65000
        },
        "avatarEmoji": {
          "type": "string",
          "maxLength": 10
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "username",
        "displayName"
      ]
    },
    "GraphSubmission": {
      "title": "GraphSubmission",
      "description": "A saved mathematical graph submission with expressions, viewport, and cartography configurations",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "authorId": {
          "type": "string",
          "maxLength": 128
        },
        "authorName": {
          "type": "string",
          "maxLength": 100
        },
        "shareCode": {
          "type": "string",
          "maxLength": 64
        },
        "isPublic": {
          "type": "boolean"
        },
        "expressionsJson": {
          "type": "string",
          "maxLength": 25000
        },
        "viewportJson": {
          "type": "string",
          "maxLength": 1000
        },
        "gridMode": {
          "type": "string",
          "maxLength": 20
        },
        "themeId": {
          "type": "string",
          "maxLength": 30
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "title",
        "authorId",
        "shareCode",
        "isPublic",
        "expressionsJson",
        "viewportJson"
      ]
    },
    "ResearchPost": {
      "title": "ResearchPost",
      "description": "A mathematical research dispatch containing theorems, conjectures, lemmas, proofs, LaTeX formulas, and attached locus expressions",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 150
        },
        "category": {
          "type": "string",
          "maxLength": 30
        },
        "authorId": {
          "type": "string",
          "maxLength": 128
        },
        "authorName": {
          "type": "string",
          "maxLength": 100
        },
        "authorTitle": {
          "type": "string",
          "maxLength": 100
        },
        "authorAvatarEmoji": {
          "type": "string",
          "maxLength": 10
        },
        "latexStatement": {
          "type": "string",
          "maxLength": 2000
        },
        "body": {
          "type": "string",
          "maxLength": 5000
        },
        "attachedExpressionsJson": {
          "type": "string",
          "maxLength": 25000
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Disciplinary tags for categorizing research posts"
        },
        "endorsementsCount": {
          "type": "number"
        },
        "isPublic": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "title",
        "category",
        "authorId",
        "latexStatement",
        "body",
        "isPublic"
      ]
    },
    "P2PRoom": {
      "title": "P2PRoom",
      "description": "Real-time P2P WebRTC signaling room and collaborative session",
      "type": "object",
      "properties": {
        "roomCode": {
          "type": "string",
          "maxLength": 32
        },
        "status": {
          "type": "string",
          "maxLength": 20
        },
        "hostOffer": {
          "type": "string",
          "maxLength": 65000
        },
        "guestAnswer": {
          "type": "string",
          "maxLength": 65000
        },
        "graphSyncJson": {
          "type": "string",
          "maxLength": 100000
        },
        "chatMessagesJson": {
          "type": "string",
          "maxLength": 100000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "roomCode",
        "status"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document keyed by auth UID"
    },
    "/graphs/{graphId}": {
      "schema": "GraphSubmission",
      "description": "Collection of user-created mathematical graph submissions"
    },
    "/research_posts/{postId}": {
      "schema": "ResearchPost",
      "description": "Collection of peer research posts, theorems, conjectures, and proofs"
    },
    "/p2p_rooms/{roomId}": {
      "schema": "P2PRoom",
      "description": "Real-time WebRTC P2P signaling rooms and live synced state"
    }
  }
}
